# Copy this file to .env for local development. Never commit real API keys.

# LLM provider configuration (live provider integration is scheduled for Phase 14).
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Local PostgreSQL connection. docker compose reads these values from .env.
POSTGRES_DB=revenue_growth_sim
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:change-me-local-only@localhost:5432/revenue_growth_sim

# Sign-in. Set a long random value (python -c "import secrets;print(secrets.token_urlsafe(48))") for any shared deployment.
# If unset, a local dev key is generated in .auth_dev_secret. Set AUTH_COOKIE_SECURE=1 when served over HTTPS.
AUTH_SECRET_KEY=
AUTH_COOKIE_SECURE=
